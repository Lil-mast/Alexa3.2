# Copy to .env.local for local work. Never commit that file.

# Point the app at another API. Default: same origin.
# The dev server proxies /api and /health to http://localhost:8000.
# VITE_API_BASE=http://localhost:8000
#
# Production builds on Vercel set this in the project environment:
# VITE_API_BASE=https://alexa-api.onrender.com
# There is no rewrite. Hash routing never asks the server for an app path.

# Compiled into the bundle at build time. Local development only.
# The public development token from backend/.env.example is `dev-token`.
# VITE_CONSOLE_TOKEN=dev-token
