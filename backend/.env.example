# Public origin Alexa+ reaches. The MCP endpoint is this URL + /mcp.
ALEXA_PUBLIC_URL=http://localhost:8000

# Accounts and sessions are the only state that survives a restart. Render
# provides DATABASE_URL for Postgres. Local development uses a file beside the
# backend; the data/ directory is created on startup.
DATABASE_URL=sqlite:///./data/alexa.db

# Bearer tokens, as a JSON object: token -> {subject, client_id, scopes}.
# The default below is a development token. Replace it before deploying.
# Generate a token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# `subject` is a stable pseudonym for one household or user. Never put a raw
# Alexa id (anything starting with amzn1.) there; the server refuses it.
ALEXA_TOKENS_JSON={"dev-token":{"subject":"house-user","client_id":"alexa-house","scopes":["home:timers:write","home:lights:write","home:climate:write","booking:rooms:write","privacy:settings:write"]}}

# Comma-separated hosts allowed by the DNS-rebinding guard. "*" is fine behind a
# TLS-terminating proxy, but narrow it to the App Runner hostname in production.
ALEXA_ALLOWED_HOSTS=*

# CORS origins for the console: Vercel production and Vite locally. Vercel
# preview URLs are different origins; add one temporarily if a preview needs to
# sign in, or use the development token.
ALEXA_CORS_ORIGINS=https://alexa.vercel.app,http://localhost:5173

# Google OAuth. The callback lives on the API origin, not the frontend origin.
# Add this exact redirect URI to the Google Cloud OAuth client:
#   local:      http://localhost:8000/api/auth/callback/google
#   production: https://alexa-api.onrender.com/api/auth/callback/google
# Scopes: openid email profile. An unverified Google email is refused.
ALEXA_GOOGLE_CLIENT_ID=
ALEXA_GOOGLE_CLIENT_SECRET=
ALEXA_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback/google
ALEXA_FRONTEND_URL=http://localhost:5173

# Seven days, in seconds. Sessions are stored by token hash and survive deploys.
ALEXA_SESSION_TTL_SECONDS=604800
# The one-time handoff from the callback to the SPA. Keep it short.
ALEXA_EXCHANGE_CODE_TTL_SECONDS=60
# Local-only shortcut for UI work without a Google project. Disabled by default
# and never exposed from a public origin, even if this is set to true.
ALEXA_AUTH_DEV_LOGIN=false

# Optional. ElevenLabs text-to-speech for the voice. Without a key the
# server reports voice disabled and the console falls back to browser speech.
# The key stays server-side. Never commit a real key.
ALEXA_ELEVENLABS_API_KEY=
ALEXA_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ALEXA_ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Longest speech string sent to the provider, in characters.
ALEXA_VOICE_MAX_CHARS=600

ALEXA_LOG_LEVEL=INFO
